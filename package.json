{
  "name": "server-name-gen",
  "version": "1.0.2",
  "description": "Generate a random, ~ unique, heroku/gcp-like name for your project, server etc. e.g. \"fragile-sack\"",
  "main": "dist/generator.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsup src/generator.ts src/cli.ts --format cjs,esm --dts --clean"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kvartet-pt/server-name-gen.git"
  },
  "keywords": [
    "heroku",
    "gcp",
    "project",
    "server",
    "app",
    "name",
    "generate",
    "unique",
    "rnd",
    "random",
    "gen",
    "generator",
    "generater"
  ],
  "author": "Nikola Susa",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "vitest": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "bin": {
    "server-name-gen": "dist/cli.js"
  }
}
